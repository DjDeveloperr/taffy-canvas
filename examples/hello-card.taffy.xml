<view
  width="420"
  height="180"
  background="#101820"
  display="flex"
  flex-direction="row"
  align-items="center"
  justify-content="space-between"
  padding-left="24"
  padding-right="24"
>
  <preview name="Default">
    <property key="name" value="Canvas" />
    <property key="score" value="9001" />
  </preview>
  <preview name="Rival">
    <property key="name" value="Rival" />
    <property key="score" value="12450" />
  </preview>
  <view display="flex" flex-direction="column" row-gap="12" margin-right="10">
    <text color="#ffffff" font-size="26">Hello {{name}}</text>
    <text color="#9fb4d1" font-size="14">Skia-rendered card template</text>
    <text color="#ffe7a6" font-size="18">Score {{score}}</text>
  </view>
  <view width="120" height="120" flex-shrink="0" radius="20" background="#20344f" display="flex">
    <view flex-grow="1" align-self="stretch" radius="18" margin="12" background="#ff4f64" />
  </view>
</view>
